# BasaltLedger environment variables.
#
# Every setting below has a working in-code default, so the tool runs with no
# .env file at all. Copy this file to .env only if you want to change the
# defaults, and export the values in your shell (BasaltLedger reads the process
# environment; it does not parse .env files itself).

# Ledger JSON document to read and write. --data PATH overrides it.
BASALTLEDGER_DATA=./basaltledger.json

# Passphrase for a ledger created with `init --passphrase`. Leave empty for an
# open ledger; when empty (or unset) the tool prompts on a terminal.
BASALTLEDGER_PASSPHRASE=

# Set to any non-empty value to disable ANSI colour (same as --no-color).
NO_COLOR=
